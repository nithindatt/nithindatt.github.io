{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gcloud/**)",
      "Read(//mnt/c/Users/*/.ssh/**)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "Read(~/AppData/Roaming/gcloud/**)",
      "Read(~/AppData/Roaming/Bitwarden CLI/**)",
      "Read(~/.config/gws/**)",
      "Read(~/.config/gws-personal/**)",
      "Read(~/.secrets/**)",
      "Bash(git push *--force*)",
      "Bash(git push *--mirror*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push -uf*)",
      "Bash(git *--no-verify*)",
      "Bash(git *--no-v*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git commit -an*)",
      "Bash(git *core.hooksPath*)",
      "Bash(pre-commit uninstall*)",
      "Bash(*pre_commit uninstall*)",
      "Bash(*SKIP=*)",
      "Edit(/.git/hooks/**)",
      "Read(~/.gam/**)",
      "Read(//c/GAMConfig/**)",
      "Read(C:/GAMConfig/**)",
      "Bash(*gws* drive files list*\"allDrives*)",
      "Bash(*gws* drive files list*'allDrives*)",
      "Bash(*gws* drive files list*=allDrives*)",
      "Bash(*/.gam*)",
      "Bash(*\\.gam*)",
      "Bash(*.gam/*)",
      "Bash(*.gam\\*)",
      "Bash(*GAMConfig*oauth2*)",
      "Bash(*GAMConfig*client_secrets*)",
      "Bash(*gamconfig*oauth2*)",
      "Bash(*gamconfig*client_secrets*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push *--mirror*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push * +*)",
      "PowerShell(git push -uf*)",
      "PowerShell(git *--no-verify*)",
      "PowerShell(git *--no-v*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n)",
      "PowerShell(git commit * -n *)",
      "PowerShell(git commit -an*)",
      "PowerShell(git *core.hooksPath*)",
      "PowerShell(pre-commit uninstall*)",
      "PowerShell(*pre_commit uninstall*)",
      "PowerShell(*SKIP=*)",
      "PowerShell(*env:SKIP*)",
      "PowerShell(*gws* drive files list*\"allDrives*)",
      "PowerShell(*gws* drive files list*'allDrives*)",
      "PowerShell(*gws* drive files list*=allDrives*)",
      "PowerShell(*/.gam*)",
      "PowerShell(*\\.gam*)",
      "PowerShell(*.gam/*)",
      "PowerShell(*.gam\\*)",
      "PowerShell(*GAMConfig*oauth2*)",
      "PowerShell(*GAMConfig*client_secrets*)",
      "PowerShell(*gamconfig*oauth2*)",
      "PowerShell(*gamconfig*client_secrets*)"
    ],
    "ask": [
      "Bash(gh pr merge*)",
      "PowerShell(gh pr merge*)"
    ]
  }
}

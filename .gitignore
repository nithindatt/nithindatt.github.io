# shared:begin (the sync from `system` writes this block; a change made here is undone at the next sync)
# Secrets: keys and credential files. Reason: secrets live in Bitwarden only, never in git.
.env
.env.*
gha-creds-*.json
secrets/
*.pem
*.key
*.p12
*.pfx
# Drive exports: `gws drive files export` without `-o` writes `download.<ext>` into the current folder. Reason: company
# data from Drive never enters git by accident (a text export passes the binary-file checks); run exports only from
# the scratch folder. A real file of that name needs a `!download.<ext>` exception line in the repository's own lines.
download.*
# shared:end

# This repository's own lines go below; the sync from `system` never touches them.

# Local settings. Reason: each person's own AI tool settings; the shared ones are committed.
.claude/settings.local.json

# Python caches. Reason: rebuildable output is not kept.
__pycache__/

# Throwaway worktrees of subagents. Reason: temporary copies, never part of the repository.
.claude/worktrees/
